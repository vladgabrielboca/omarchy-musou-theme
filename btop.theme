# Musou btop theme — matte charcoal (#0b0b0b) instrument panel with uniform graphite borders
# and Smoke Violet reserved only for keyboard shortcut hints and active selection.

theme[main_bg]="#0b0b0b"
theme[main_fg]="#dcdcdc"
theme[title]="#f0f0f0"
theme[hi_fg]="#9c94c8"
theme[selected_bg]="#1c1c1c"
theme[selected_fg]="#9c94c8"
theme[inactive_fg]="#707070"
theme[graph_text]="#cccccc"
theme[meter_bg]="#1c1c1c"
theme[proc_misc]="#b8b8b8"

# Uniform quiet graphite outlines for all panels
theme[cpu_box]="#3d3d3d"
theme[mem_box]="#3d3d3d"
theme[net_box]="#3d3d3d"
theme[proc_box]="#3d3d3d"
theme[div_line]="#262626"

# Clean monochrome gradients
theme[temp_start]="#8a8a8a"
theme[temp_mid]="#b8b8b8"
theme[temp_end]="#dcdcdc"

theme[cpu_start]="#8a8a8a"
theme[cpu_mid]="#b8b8b8"
theme[cpu_end]="#dcdcdc"

theme[free_start]="#7a7a7a"
theme[free_mid]="#a8a8a8"
theme[free_end]="#d0d0d0"

theme[cached_start]="#7a7a7a"
theme[cached_mid]="#a8a8a8"
theme[cached_end]="#d0d0d0"

theme[available_start]="#8a8a8a"
theme[available_mid]="#b4b4b4"
theme[available_end]="#d8d8d8"

theme[used_start]="#8a8a8a"
theme[used_mid]="#b8b8b8"
theme[used_end]="#dcdcdc"

theme[download_start]="#8a8a8a"
theme[download_mid]="#b8b8b8"
theme[download_end]="#dcdcdc"

theme[upload_start]="#7a7a7a"
theme[upload_mid]="#a8a8a8"
theme[upload_end]="#d0d0d0"

theme[process_start]="#909090"
theme[process_mid]="#bdbdbd"
theme[process_end]="#dcdcdc"

theme[gradient_color_0]="#0b0b0b"
theme[gradient_color_1]="#1c1c1c"
theme[gradient_color_2]="#3a3a3a"
theme[gradient_color_3]="#5c5c5c"
theme[gradient_color_4]="#808080"
theme[gradient_color_5]="#a4a4a4"
theme[gradient_color_6]="#c4c4c4"
theme[gradient_color_7]="#dcdcdc"
