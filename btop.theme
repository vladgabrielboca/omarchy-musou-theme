# Musou btop theme — matte charcoal (#141414) instrument panel with uniform graphite borders
# and Smoke Violet reserved only for keyboard shortcut hints and active selection.

theme[main_bg]="#0b0b0b"
theme[main_fg]="#ffffff"
theme[title]="#ffffff"
theme[hi_fg]="#887cd4"
theme[selected_bg]="#1c1c1c"
theme[selected_fg]="#887cd4"
theme[inactive_fg]="#585858"
theme[graph_text]="#cccccc"
theme[meter_bg]="#1c1c1c"
theme[proc_misc]="#b8b8b8"

# Uniform quiet graphite outlines for all panels
theme[cpu_box]="#3d3d3d"
theme[mem_box]="#3d3d3d"
theme[net_box]="#3d3d3d"
theme[proc_box]="#3d3d3d"
theme[div_line]="#262626"

# Clean monochrome gradients
theme[temp_start]="#8a8a8a"
theme[temp_mid]="#bfbfbf"
theme[temp_end]="#ffffff"

theme[cpu_start]="#8a8a8a"
theme[cpu_mid]="#bfbfbf"
theme[cpu_end]="#ffffff"

theme[free_start]="#7a7a7a"
theme[free_mid]="#ababab"
theme[free_end]="#dadada"

theme[cached_start]="#7a7a7a"
theme[cached_mid]="#ababab"
theme[cached_end]="#dadada"

theme[available_start]="#8a8a8a"
theme[available_mid]="#b8b8b8"
theme[available_end]="#e6e6e6"

theme[used_start]="#8a8a8a"
theme[used_mid]="#bfbfbf"
theme[used_end]="#ffffff"

theme[download_start]="#8a8a8a"
theme[download_mid]="#bfbfbf"
theme[download_end]="#ffffff"

theme[upload_start]="#7a7a7a"
theme[upload_mid]="#ababab"
theme[upload_end]="#dadada"

theme[process_start]="#999999"
theme[process_mid]="#c8c8c8"
theme[process_end]="#ffffff"

theme[gradient_color_0]="#0b0b0b"
theme[gradient_color_1]="#1c1c1c"
theme[gradient_color_2]="#3a3a3a"
theme[gradient_color_3]="#606060"
theme[gradient_color_4]="#888888"
theme[gradient_color_5]="#b2b2b2"
theme[gradient_color_6]="#dedede"
theme[gradient_color_7]="#ffffff"
